#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/unicode.dtsi>

#define LT1 0
#define LT2 1
#define LT3 2
#define LT4 3
#define LT5 4
#define LM1 10
#define LM2 11
#define LM3 12
#define LM4 13
#define LM5 14
#define LB1 20
#define LB2 21
#define LB3 22
#define LB4 23
#define LB5 24
#define LC1 30
#define LC2 31
#define LEFT_KEYS LT1 LT2 LT3 LT4 LT5 LM1 LM2 LM3 LM4 LM5 LB1 LB2 LB3 LB4 LB5
#define LEFT_THUMBS LC1 LC2

#define RT1 9
#define RT2 8
#define RT3 7
#define RT4 6
#define RT5 5
#define RM1 19
#define RM2 18
#define RM3 17
#define RM4 16
#define RM5 15
#define RB1 29
#define RB2 28
#define RB3 27
#define RB4 26
#define RB5 25
#define RC1 33
#define RC2 32
#define RIGHT_KEYS RT1 RT2 RT3 RT4 RT5 RM1 RM2 RM3 RM4 RM5 RB1 RB2 RB3 RB4 RB5
#define RIGHT_THUMBS RC1 RC2

#define ALL_KEYS LEFT_KEYS RIGHT_KEYS
#define ALL_THUMBS LEFT_THUMBS RIGHT_THUMBS

#define L_DEF 0
#define L_EXT 1
#define L_SYM 2
#define L_NUM 3

&mt {
    // flavor = "tap-preferred";
    // tapping-term-ms = <200>;
};

&sk {
    release-after-ms = <2000>;
};

&uc {
    default-mode = <UC_MODE_LINUX>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_KEYS ALL_THUMBS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_KEYS ALL_THUMBS>;
            hold-trigger-on-release;
        };
        hmldr: home_row_mod_leader_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&leader>;
            hold-trigger-key-positions = <RIGHT_KEYS ALL_THUMBS>;
            hold-trigger-on-release;
        };

        l_sym: key_and_sym_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&mo L_SYM>;
            hold-trigger-key-positions = <ALL_KEYS>;
            hold-trigger-on-release;
        };


        mshift: magic_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };

        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;

            // Settings
            usb { sequence = <U S B>; bindings = <&out OUT_USB>; };
            ble { sequence = <B L E>; bindings = <&out OUT_BLE>; };

            bt0 { sequence = <B S A>; bindings = <&bt BT_SEL 0>; }; // A -> 0
            bt1 { sequence = <B S R>; bindings = <&bt BT_SEL 1>; }; // R -> 1
            bt2 { sequence = <B S S>; bindings = <&bt BT_SEL 2>; }; // S -> 2
            bt3 { sequence = <B S T>; bindings = <&bt BT_SEL 3>; }; // T -> 3
            btc { sequence = <B C L R>; bindings = <&bt BT_CLR>; };

            macos { sequence = <S M A C>; bindings = <&uc UC_SET_MACOS>; };
            windows { sequence = <S W I N>; bindings = <&uc UC_SET_WIN_ALT>; };
            linux { sequence = <S L I N>; bindings = <&uc UC_SET_MACOS>; };
            emacs { sequence = <S E M A C S>; bindings = <&uc UC_SET_EMACS>; };

            // Management
            boot { sequence = <B O O T>; bindings = <&bootloader>; };
            reset { sequence = <R E S E T>; bindings = <&sys_reset>; };
            soft_off { sequence = < O F F>; bindings = <&soft_off>; };

            // Accents
            ae { sequence = <A E>; bindings = <&uc UC_FR_AE>; };
            oe { sequence = <O E>; bindings = <&uc UC_FR_OE>; };
            ss { sequence = <S S>; bindings = <&uc UC_DE_SS>; };

            // Currencies
            cent { sequence = <C C E N T>; bindings = <&uc UC_CURR_CENT>; };
            pound { sequence = <C P O U N D>; bindings = <&uc UC_CURR_POUND>; };
            yen { sequence = <C Y E N>; bindings = <&uc UC_CURR_YEN>; };
            yuan { sequence = <C Y U A N>; bindings = <&uc UC_CURR_YEN>; };
            rmb { sequence = <C R M B>; bindings = <&uc UC_CURR_YEN>; };
            won { sequence = <C W O N>; bindings = <&uc UC_CURR_WON>; };
            euro { sequence = <C E U R O>; bindings = <&uc UC_CURR_EURO>; };
            ruble { sequence = <C R U B L E>; bindings = <&uc UC_CURR_RUBLE>; };
            turkish_lira { sequence = <C L I R A>; bindings = <&uc UC_CURR_TURKISH_LIRA>; };
        };

        swap: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";
        leader_left {
            timeout-ms = <30>;
            key-positions = <LM3 LM4>;
            layers = <0>;
            bindings = <&hmldr LS(LCTRL) 0>;
            require-prior-idle-ms = <150>;
        };

        num_layer_thumbs {
            timeout-ms = <30>;
            key-positions = <LC1 RC1>;
            layers = <0>;
            bindings = <&mo L_NUM>;
            require-prior-idle-ms = <100>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q       &kp W       &kp F        &kp P        &kp B                      &kp J &kp L         &kp U        &kp Y       &kp SEMI
                &hml LGUI A &hml LALT R &hml LSHFT S &hml LCTRL T &kp G                      &kp M &hmr LCTRL N  &hmr RSHFT E &hmr LALT I &hmr LGUI O
                &kp Z       &kp X       &kp C        &kp D        &kp V                      &kp K &kp H         &kp COMMA    &kp DOT     &kp SLASH
                                                            &mshift &mo 1                  &kp ENTER &l_sym SPACE 0
            >;
        };

        ext_layer {
            bindings = <
                &none   &swap   &none     &none    &kp C_NEXT                      &none &kp LGUI &sk LCTRL &sk LALT &sk LGUI
                &kp ESC &kp TAB &kp ENTER &kp BSPC &kp C_PP                        &none &kp LEFT &kp DOWN  &kp UP   &kp RIGHT
                &none   &none   &none     &kp DEL  &kp C_PREV                      &none &none    &none     &none    &leader
                                                  &none  &trans                  &none &none
            >;
        };

        sym_layer {
            bindings = <
                &kp CARET  &kp EXCL  &kp QMARK &kp AT    &kp PRCNT                     &kp ASTRK &kp UNDER &kp PIPE &kp DQT   &none
                &kp LT     &kp COLON &kp LBRC  &kp LPAR  &kp LBKT                      &kp HASH  &kp MINUS &kp BSLH &kp SQT   &kp DLLR
                &kp GT     &kp SEMI  &kp RBRC  &kp RPAR  &kp RBKT                      &kp AMPS  &kp TILDE &none    &kp GRAVE &none
                                                    &kp EQUAL &none                 &trans  &none
            >;
        };

        num_layer {
            bindings = <
                &none  &kp N7 &kp N8 &kp N9 &kp PLUS                       &none &kp F9 &kp F10 &kp F11 &kp F12
                &none  &kp N4 &kp N5 &kp N6 &kp PRCNT                      &none &kp F5 &kp F6  &kp F7  &kp F8
                &kp N0 &kp N1 &kp N2 &kp N3 &none                          &none &kp F1 &kp F2  &kp F3  &kp F4
                                            &none &none                  &none &none
            >;
        };
    };
};
